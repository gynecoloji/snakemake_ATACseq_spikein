# ATAC-seq spike-in normalization + consensus + QC — Snakemake Workflow Catalog
# entry point. A single `snakemake --use-conda` builds the primary pipeline AND
# the QC report in dependency order (unified DAG). Run a subset with the
# `atacseq_all` or `qc_all` targets:
#
#   snakemake --use-conda --cores 20                 # everything (primary → QC)
#   snakemake --use-conda --cores 20 atacseq_all     # primary pipeline only
#   snakemake --use-conda --cores 20 qc_all          # QC only (after primary)
#
# Differential openness is an OPT-IN stage (needs >=2 conditions in samples.csv);
# it is not part of the default target:
#   snakemake --use-conda --cores 20 diffopen_all          # none + spikein + ctcf
#   snakemake --use-conda --cores 20 diffopen_anchor_shape # hybrid (Method 6)
#
# Reference genomes/annotation are provided by the user under ref/ (see README).

from snakemake.utils import min_version

min_version("8.0")


# ── driver / environment Snakemake version check ────────────────────────
# Rules that use `script:` run their Python INSIDE workflow/envs/snakemake.yaml,
# through a wrapper the *driver* Snakemake generates. If the driver's minor
# version differs from the one pinned in that env, the wrapper calls an API the
# env's Snakemake does not have and the rule dies with a bare CalledProcessError
# and an EMPTY log file -- 30-80 minutes into a run, at `compute_spikein_factors`
# or `consensus_peaks`, with no traceback anywhere. Fail immediately instead.
#
#   ImportError: cannot import name 'snakemake' from 'snakemake.script'
#
# Patch drift is fine; only major.minor must agree.
def _check_driver_version():
    import re
    from pathlib import Path

    from snakemake import __version__ as driver_version

    env_yaml = Path(workflow.basedir) / "envs" / "snakemake.yaml"
    if not env_yaml.exists():
        return
    m = re.search(r"^\s*-\s*snakemake\s*=\s*([0-9][0-9.]*)", env_yaml.read_text(), re.M)
    if not m:
        return
    pinned = m.group(1)
    driver = driver_version.split("+")[0]
    if driver.split(".")[:2] != pinned.split(".")[:2]:
        raise WorkflowError(
            f"Snakemake version mismatch: the driver running this workflow is "
            f"{driver}, but workflow/envs/snakemake.yaml pins snakemake={pinned}.\n"
            f"Rules that use `script:` will fail with an empty log file.\n\n"
            f"Fix by installing a matching driver, e.g.\n"
            f"    mamba create -n atacseq -c conda-forge -c bioconda "
            f"snakemake-minimal={pinned} pandas\n"
            f"or by driving the workflow with the environment's own Snakemake."
        )


_check_driver_version()


configfile: "config/config.yaml"


include: "rules/common.smk"
include: "rules/atacseq.smk"
include: "rules/qc.smk"
include: "rules/diffopen.smk"


rule all:
    input:
        rules.atacseq_all.input,
        rules.qc_all.input,
    default_target: True
